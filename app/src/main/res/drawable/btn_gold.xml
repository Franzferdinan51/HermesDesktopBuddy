<?xml version="1.0" encoding="utf-8"?>
<!-- Primary gold button: glossy, rounded, Muse-style -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="#F5D76E"
                android:centerColor="#D4AF37"
                android:endColor="#A8842A"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#88FFFFFF" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="2dp"
        android:bottom="60dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="90"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
