<?xml version="1.0" encoding="utf-8"?>
<!-- Hermes message bubble: navy card gradient, full 22dp radius -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="#274167"
                android:centerColor="@color/muse_card"
                android:endColor="#113466"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="2dp"
        android:height="26dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="90"
                android:startColor="#2EFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
