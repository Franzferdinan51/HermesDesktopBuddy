<?xml version="1.0" encoding="utf-8"?>
<!-- User message bubble: Muse blue gradient, full 22dp radius -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/muse_blue_light"
                android:centerColor="@color/muse_blue"
                android:endColor="#1467D4"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#57FFFFFF" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="2dp"
        android:height="26dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="90"
                android:startColor="#4DFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
