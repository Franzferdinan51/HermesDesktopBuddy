<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy card: MuseBubble-style with gold-tinted shadow and top gloss -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- base gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="#2E2E4A"
                android:centerColor="#23233A"
                android:endColor="#1B1B2F"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
        </shape>
    </item>
    <!-- top gloss band -->
    <item
        android:left="12dp"
        android:right="12dp"
        android:top="2dp"
        android:bottom="200dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="90"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
