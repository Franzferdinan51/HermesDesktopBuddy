<?xml version="1.0" encoding="utf-8"?>
<!-- Glossy card, MuseBubble recipe: navy gradient, white 0.22 border, top gloss.
     Pair with android:elevation + outlineSpotShadowColor for the blue shadow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="315"
                android:startColor="@color/muse_card_top"
                android:centerColor="@color/muse_card"
                android:endColor="@color/muse_card_bottom"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
        </shape>
    </item>
    <item
        android:left="12dp"
        android:right="12dp"
        android:top="2dp"
        android:bottom="200dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="18dp"
                android:bottomLeftRadius="4dp"
                android:bottomRightRadius="4dp" />
            <gradient
                android:angle="90"
                android:startColor="#38FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
