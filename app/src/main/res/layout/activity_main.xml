<?xml version="1.0" encoding="utf-8"?>
<!-- Companion home: Hermes avatar stage, status card, caption, actions.
     Mirrors MuseCompanionApp's companion_screen: avatar disc, status lines, bottom bar. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Hermes mark + name + battery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/avatar_ring" />

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/avatar_bg"
                    android:clipToOutline="true"
                    android:src="@drawable/ic_hermes_mark"
                    android:contentDescription="Hermes" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/HermesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hermes Buddy"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/pairedLabel"
                    style="@style/HermesSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Not paired" />
            </LinearLayout>

            <View
                android:id="@+id/statusDot"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/status_dot_offline" />
        </LinearLayout>

        <!-- Avatar stage: large Hermes disc, Muse-style companion stage -->
        <ImageView
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:src="@drawable/hermes_avatar"
            android:contentDescription="Hermes Buddy" />

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_glossy"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <View
                android:id="@+id/statusDotCard"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/status_dot_offline" />

            <TextView
                android:id="@+id/statusText"
                style="@style/HermesBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Disconnected"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Caption card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_glossy"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/HermesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last update"
                android:textStyle="bold"
                android:textColor="@color/hermes_gold" />

            <TextView
                android:id="@+id/captionText"
                style="@style/HermesBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="44dp"
                android:text="Not connected" />
        </LinearLayout>

        <!-- Pairing code card -->
        <LinearLayout
            android:id="@+id/pairCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_glossy"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                style="@style/HermesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pairing code — approve on the Hermes host:" />

            <TextView
                android:id="@+id/pairCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="—"
                android:textColor="@color/hermes_gold"
                android:textSize="36sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
        </LinearLayout>

        <!-- Actions -->
        <Button
            android:id="@+id/btnChat"
            style="@style/HermesGoldButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Chat with Hermes" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPair"
                style="@style/HermesGhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pair" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/HermesGhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReconnect"
                style="@style/HermesGhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reconnect" />

            <Button
                android:id="@+id/btnNewSession"
                style="@style/HermesGhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="New session" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
