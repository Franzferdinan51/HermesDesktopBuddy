<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Connection card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_glossy"
            android:elevation="8dp"
            android:outlineSpotShadowColor="@color/muse_blue_shadow"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/HermesSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connection" />

            <TextView
                style="@style/HermesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Hermes host URL" />

            <EditText
                android:id="@+id/hostUrl"
                style="@style/HermesField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="ws://host:8765/gadget"
                android:inputType="textUri" />

            <TextView
                style="@style/HermesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Device name" />

            <EditText
                android:id="@+id/deviceName"
                style="@style/HermesField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Duckets Phone"
                android:inputType="text" />
        </LinearLayout>

        <!-- Voice card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_glossy"
            android:elevation="8dp"
            android:outlineSpotShadowColor="@color/muse_blue_shadow"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/HermesSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Voice" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/HermesBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Speak replies aloud"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/ttsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/HermesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Mic sample rate (Hz)" />

            <EditText
                android:id="@+id/micRate"
                style="@style/HermesField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="16000"
                android:inputType="number" />
        </LinearLayout>

        <!-- Device card -->
        <LinearLayout
            android:id="@+id/deviceIdRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_glossy"
            android:elevation="8dp"
            android:outlineSpotShadowColor="@color/muse_blue_shadow"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/HermesSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device ID — tap to copy" />

            <TextView
                android:id="@+id/deviceIdValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="—"
                android:textColor="@color/hermes_text_primary"
                android:textIsSelectable="true"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Diagnostics card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_glossy"
            android:elevation="8dp"
            android:outlineSpotShadowColor="@color/muse_blue_shadow"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/HermesSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostics" />

            <TextView
                android:id="@+id/diagText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="—"
                android:textColor="@color/hermes_text_primary"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnResetKey"
                style="@style/HermesGhostButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Reset device key &amp; re-pair" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            style="@style/HermesPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Save" />

        <Button
            android:id="@+id/btnReconnect"
            style="@style/HermesGhostButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:text="Save &amp; reconnect" />
    </LinearLayout>
</ScrollView>
